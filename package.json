{
  "schema": "https://json.schemastore.org/package.json",
  "name": "nodefota",
  "type": "module",
  "private": true,
  "description": "Secure Firmware Over The Air Platform by Nodewave",
  "author": {
    "name": "Yebei-Gideon",
    "email": "yebei@nodewave.net",
    "url": "https://nodewave.net"
  },
  "homepage": "https://github.com/Nodewave-EA/nodefota",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nodewave-EA/nodefota.git"
  },
  "bugs": {
    "email": "bugs-fota@nodewave.net",
    "url": "https://github.com/Nodewave-EA/nodefota/issues"
  },
  "module": "index.ts",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' --parallel --output-style grouped dev",
    "dev:api": "bun --filter '@fota/api' dev",
    "dev:web": "bun --filter '@fota/web' dev",
    "nest": "./apps/api/nest.sh",
    "build": "bun --filter '*' --parallel --output-style grouped build",
    "build:web": "bun --filter '@fota/web' build",
    "build:api": "bun --filter '@fota/api' build",
    "lint": "eslint . --fix --cache --cache-location ./node_modules/.cache/eslint",
    "lint:verbose": "DEBUG=eslint:* eslint . --fix --cache --cache-location ./node_modules/.cache/eslint",
    "typecheck": "bun --filter '*' --parallel --output-style grouped typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/bun": "latest",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "typescript": "^6"
  },
  "lint-staged": {
    "*": "eslint --fix",
    "*.{sh,bash,zsh,fish}": [
      "shfmt -w -i 2 -ci",
      "shellcheck"
    ]
  }
}
