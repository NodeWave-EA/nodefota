# Stage 1: Build the Nuxt application
FROM node:26-slim AS builder

WORKDIR /app

# Install Bun globally for package management
RUN npm install -g bun

# Copy web app package manifest
COPY package.json ./

# Install dependencies required for building
RUN bun install

# Copy application source code
COPY . .

# Build Nuxt standalone production output (.output)
RUN bun run build

# Stage 2: Production runtime
FROM node:26-slim AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NITRO_HOST=0.0.0.0 \
    NITRO_PORT=5040

# Copy built Nitro output from builder and assign ownership to 1000:1000
COPY --from=builder --chown=1000:1000 /app/.output ./.output

USER 1000:1000

EXPOSE 5040

# Launch standalone Nitro server using Node 26 runtime
CMD ["node", ".output/server/index.mjs"]
