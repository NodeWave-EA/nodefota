FROM node:26-slim

# Install Bun globally for package management
RUN npm install -g bun

WORKDIR /app

# Copy package manifest
COPY package.json ./

# Install dependencies inside container node_modules
RUN bun install

# Copy source code and schemas
COPY . .

# Generate Prisma client using placeholder URLs during build (real .env is injected at runtime)
RUN if [ -d "prisma" ]; then \
      DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" \
      SHADOW_DATABASE_URL="postgresql://dummy:dummy@localhost:5432/shadow" \
      bunx prisma generate; \
    fi \
    && mkdir -p /app/node_modules \
    && chown -R 1000:1000 /app

# Add node_modules/.bin to PATH
ENV PATH="/app/node_modules/.bin:${PATH}"

EXPOSE 5050

CMD ["sh", "-c", "bun install && if [ -d \"prisma\" ]; then bunx prisma generate; fi && bun run dev"]