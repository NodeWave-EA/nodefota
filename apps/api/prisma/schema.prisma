generator client {
  provider = "prisma-client"
  output   = "../src/modules/prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  first_name         String?
  last_name          String?
  company_name       String?
  phone_number       String?
  country            String?
  user_name          String?
  role               String    @default("OPERATOR")
  avatar_url         String?
  email              String    @unique
  email_confirmed    Boolean   @default(false)
  email_confirmed_at DateTime?
  password           String

  provider       String  @default("local")
  provider_id    String?
  provider_email String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
