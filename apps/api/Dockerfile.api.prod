# --- Stage 1: Build ---
FROM node:26-slim AS builder

WORKDIR /app

# Install Bun globally for fast dependency management
RUN npm install -g bun

# Copy package manifest
COPY package.json ./

# Install all dependencies required for building
RUN bun install

# Copy application source code and Prisma schema
COPY . .

# Generate Prisma Client (using placeholder URLs) and compile NestJS application
RUN if [ -d "prisma" ]; then \
      DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" \
      SHADOW_DATABASE_URL="postgresql://dummy:dummy@localhost:5432/shadow" \
      bunx prisma generate; \
    fi \
    && bun run build

# --- Stage 2: Production Runtime ---
FROM node:26-slim AS runtime

WORKDIR /app

# Install Bun globally for production dependency installation
RUN npm install -g bun

ENV NODE_ENV=production

# Copy package manifest and install production-only dependencies
COPY package.json ./
RUN bun install --production

# Copy compiled application code and Prisma artifacts (if generated inside node_modules)
COPY --from=builder /app/dist ./dist
RUN --mount=from=builder,source=/app/node_modules,target=/tmp/builder_nm \
    if [ -d "/tmp/builder_nm/.prisma" ]; then cp -r /tmp/builder_nm/.prisma ./node_modules/.prisma; fi && \
    if [ -d "/tmp/builder_nm/@prisma" ]; then cp -r /tmp/builder_nm/@prisma ./node_modules/@prisma; fi

# Assign recursive non-root ownership to node user (UID/GID 1000)
RUN chown -R 1000:1000 /app

USER 1000:1000

EXPOSE 5050

CMD ["node", "dist/main.js"]