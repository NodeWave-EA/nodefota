[submodule "packages/fota-client-esp32"]
	path = packages/fota-client-esp32
	url = https://github.com/NodeWave-EA/FOTA-Client-ESP32
	ignore = dirty
[submodule "docker/supabase"]
	path = docker/supabase
	url = https://github.com/NodeWave-EA/supabase-docker.git
	branch = release/v0.8.5
	update = checkout
	ignore = dirty
	fetchRecurseSubmodules = on-demand
	shallow = true
